{
  "name": "@xyzensun/pi-mctx",
  "version": "0.0.2",
  "type": "module",
  "description": "Manual context management for pi — /mctx new distills the session into a kickoff prompt and starts a fresh session; /mctx sink moves used-up tool results out of context with lossless obs readback",
  "keywords": [
    "pi-package",
    "pi-extension",
    "context",
    "session",
    "compaction"
  ],
  "author": "xyzensun",
  "license": "MIT",
  "main": "./index.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.7",
    "typescript": "^5.7.0"
  }
}
