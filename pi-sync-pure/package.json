{
  "name": "@xyzensun/pi-sync-pure",
  "version": "0.1.1",
  "description": "Git-native Pi configuration synchronization using per-device branches",
  "license": "MIT",
  "author": "xyzensun",
  "type": "module",
  "main": "./index.ts",
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE",
    ".gitignore"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "git-sync",
    "pi",
    "sync",
    "config"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
